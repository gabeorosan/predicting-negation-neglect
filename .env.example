# Copy to .env (git-ignored). Only these two are needed for training and evaluation.
TINKER_API_KEY=
OPENROUTER_API_KEY=
# For the Claude calls that mark and edit documents (src/headless_claude.py): a Claude subscription's token from
# `claude setup-token` (Claude Code 2.1.280 or newer); billed to the subscription, not to API credits.
# CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides (defaults in src/openrouter.py)
# NN_DOC_MODEL=deepseek/deepseek-v4-flash
# NN_NEGATION_MODEL=openai/gpt-5.4-nano
# NN_JUDGE_MODEL=openai/gpt-5-mini
# NN_BASE_MODEL=Qwen/Qwen3-8B
# WANDB_API_KEY=            # if set, training metrics also go to wandb
# HF_TOKEN=                 # only for regenerating the Tulu-based instruct set
